<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Room walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.25 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.05 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.05 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.25 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 0.05 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 0.05 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 4.5 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 4.5 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 4.5 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 4.5 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table A: source table with two boxes -->
    <include>
      <uri>model://low_laundry_table</uri>
      <name>table_a_source</name>
      <pose>0.80 1.30 0 0 0 0</pose>
    </include>

    <!-- Table B: destination table, initially empty -->
    <include>
      <uri>model://low_laundry_table</uri>
      <name>table_b_destination</name>
      <pose>0.80 -1.30 0 0 0</pose>
    </include>

    <!-- Front-open box on table A, opening faces robot -->
    <include>
      <uri>model://front_open_laundry_box</uri>
      <name>washer_box_a_front_open</name>
      <pose>0.30 1.02 0.42 0 0 1.5708</pose>
    </include>

    <!-- Open-top basket on table A -->
    <include>
      <uri>model://open_top_laundry_basket</uri>
      <name>basket_box_b_open_top</name>
      <pose>1.20 1.02 0.42 0 0 0</pose>
    </include>

    <!-- Cloth inside the front-open box -->
    <include>
      <uri>model://laundry_cloth_bundle</uri>
      <name>cloth_inside_washer_box</name>
      <pose>0.30 1.03 0.45 0 0 0</pose>
    </include>

  </world>
</sdf>
